.claude/worktrees/

# Rust
/target/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.benchmarks/
.coverage
*.egg-info/
.ruff_cache/

# In-place compiled extension from `pip install -e .`
python/snakes_and_ladders/*.so
python/snakes_and_ladders/*.pyd
python/snakes_and_ladders/*.dylib

# Sphinx build output
docs/_build/

# LaTeX build output (the technical PDF is built, not committed)
docs/tex/*.aux
docs/tex/*.bbl
docs/tex/*.blg
docs/tex/*.fdb_latexmk
docs/tex/*.fls
docs/tex/*.log
docs/tex/*.out
docs/tex/*.pdf
docs/tex/*.toc

# QA figures/captions under docs/tex/figures/ are committed, not ignored:
# they are the technical document's evidence, and a reviewer should see a
# changed plot in the diff rather than have to build the document to find
# out. infra/build_technical_doc.sh regenerates them, and CI rebuilds and
# compares the rendered document, so a stale figure still fails.

# infra/build_technical_doc.sh's LaTeX build output. The PDFs themselves
# are committed (see DEV.md); everything latexmk leaves beside them is not.
docs/paper.aux
docs/paper.bbl
docs/paper.blg
docs/paper.fdb_latexmk
docs/paper.fls
docs/paper.log
docs/paper.out
docs/paper.toc
docs/textbook.aux
docs/textbook.bbl
docs/textbook.blg
docs/textbook.fdb_latexmk
docs/textbook.fls
docs/textbook.log
docs/textbook.out
docs/textbook.toc

