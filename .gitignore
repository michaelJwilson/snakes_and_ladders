.claude/worktrees/

# Rust
/target/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.benchmarks/
.coverage
*.egg-info/
.ruff_cache/

# In-place compiled extension from `pip install -e .`
python/snakes_and_ladders/*.so
python/snakes_and_ladders/*.pyd
python/snakes_and_ladders/*.dylib

# Sphinx build output
docs/_build/

# LaTeX build output (the PDFs are built into docs/, not left here)
docs/tex/*.aux
docs/tex/*.bbl
docs/tex/*.blg
docs/tex/*.fdb_latexmk
docs/tex/*.fls
docs/tex/*.log
docs/tex/*.out
docs/tex/*.pdf
docs/tex/*.toc

# QA figures/captions under docs/tex/figures/ are committed, not ignored:
# they are the documents' evidence, and a reviewer should see a
# changed plot in the diff rather than have to build a document to find
# out. infra/build_documents.sh regenerates them, and CI rebuilds and
# compares the rendered document, so a stale figure still fails.

# infra/build_documents.sh's LaTeX build output. The PDFs themselves
# are committed (see DEV.md); everything latexmk leaves beside them is not.
docs/*.aux
docs/*.bbl
docs/*.blg
docs/*.fdb_latexmk
docs/*.fls
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz

